{
  "version": 6,
  "configurePresets": [
    {
      "name": "lab-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/lab-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRAWBORAD_DESKTOP": "OFF",
        "DRAWBORAD_QUALIFY": "OFF",
        "DRAWBORAD_SANITIZE": "OFF"
      }
    },
    {
      "name": "lab-asan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/lab-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRAWBORAD_DESKTOP": "OFF",
        "DRAWBORAD_QUALIFY": "OFF",
        "DRAWBORAD_SANITIZE": "ON"
      }
    },
    {
      "name": "lab-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/lab-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DRAWBORAD_DESKTOP": "OFF",
        "DRAWBORAD_QUALIFY": "OFF",
        "DRAWBORAD_SANITIZE": "OFF"
      }
    },
    {
      "name": "win-validation",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/win-validation",
      "cacheVariables": {
        "DRAWBORAD_DESKTOP": "ON",
        "DRAWBORAD_QUALIFY": "OFF",
        "DRAWBORAD_WINDOWS_VALIDATION": "ON",
        "DRAWBORAD_SANITIZE": "OFF"
      }
    },
    {
      "name": "win-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/win-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRAWBORAD_DESKTOP": "ON",
        "DRAWBORAD_QUALIFY": "ON",
        "DRAWBORAD_WINDOWS_VALIDATION": "OFF",
        "DRAWBORAD_SANITIZE": "OFF"
      }
    },
    {
      "name": "win-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/win-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DRAWBORAD_DESKTOP": "ON",
        "DRAWBORAD_QUALIFY": "ON",
        "DRAWBORAD_WINDOWS_VALIDATION": "OFF",
        "DRAWBORAD_SANITIZE": "OFF"
      }
    },
    {
      "name": "win-asan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/win-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRAWBORAD_DESKTOP": "ON",
        "DRAWBORAD_QUALIFY": "ON",
        "DRAWBORAD_WINDOWS_VALIDATION": "OFF",
        "DRAWBORAD_SANITIZE": "ON"
      }
    },
    {
      "name": "core-portable-release",
      "inherits": "lab-release",
      "binaryDir": "${sourceDir}/out/build/core-portable-release",
      "cacheVariables": {
        "DRAWBORAD_TEST_PROFILE": "CorePortable",
        "DRAWBORAD_ONNXRUNTIME_ROOT": ""
      }
    },
    {
      "name": "win-integrated-rc1",
      "inherits": "win-validation",
      "binaryDir": "${sourceDir}/out/build/win-integrated-rc1",
      "cacheVariables": {
        "DRAWBORAD_TEST_PROFILE": "RealWindowsIntegration",
        "DRAWBORAD_ONNXRUNTIME_ROOT": "$env{DRAWBORAD_ONNXRUNTIME_ROOT}",
        "DRAWBORAD_TEST_COFFEE_IMAGE": "$env{DRAWBORAD_TEST_COFFEE_IMAGE}",
        "DRAWBORAD_TEST_COFFEE_PACKAGE": "$env{DRAWBORAD_TEST_COFFEE_PACKAGE}",
        "DRAWBORAD_TEST_COFFEE_REFERENCE": "$env{DRAWBORAD_TEST_COFFEE_REFERENCE}",
        "DRAWBORAD_TEST_COFFEE_AUTO_REFERENCE": "$env{DRAWBORAD_TEST_COFFEE_AUTO_REFERENCE}",
        "DRAWBORAD_TEST_FULL_SCENE_REFERENCE": "$env{DRAWBORAD_TEST_FULL_SCENE_REFERENCE}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "lab-debug",
      "configurePreset": "lab-debug",
      "jobs": 2
    },
    {
      "name": "lab-asan",
      "configurePreset": "lab-asan",
      "jobs": 2
    },
    {
      "name": "lab-release",
      "configurePreset": "lab-release",
      "jobs": 2
    },
    {
      "name": "win-validation",
      "configurePreset": "win-validation",
      "configuration": "Debug",
      "jobs": 2
    },
    {
      "name": "win-debug",
      "configurePreset": "win-debug",
      "jobs": 2
    },
    {
      "name": "win-release",
      "configurePreset": "win-release",
      "jobs": 2
    },
    {
      "name": "win-asan",
      "configurePreset": "win-asan",
      "jobs": 2
    },
    {
      "name": "core-portable-release",
      "configurePreset": "core-portable-release",
      "jobs": 2
    },
    {
      "name": "win-integrated-rc1",
      "configurePreset": "win-integrated-rc1",
      "configuration": "Release",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "lab-debug",
      "configurePreset": "lab-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "lab-asan",
      "configurePreset": "lab-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "lab-release",
      "configurePreset": "lab-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-validation",
      "configurePreset": "win-validation",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-debug",
      "configurePreset": "win-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-release",
      "configurePreset": "win-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-asan",
      "configurePreset": "win-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-portable-release",
      "configurePreset": "core-portable-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-integrated-rc1",
      "configurePreset": "win-integrated-rc1",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
