FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DRAWBORAD_CLOUD_DATA=/data \
    DRAWBORAD_NATIVE_ENGINE=/app/out/linux-headless/DrawboradHeadless

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    cmake \
    ninja-build \
    make \
    pkg-config \
    g++ \
    qt6-base-dev \
    qt6-base-private-dev \
    qt6-declarative-dev \
    qml6-module-qtquick \
    qml6-module-qtquick-controls \
    qml6-module-qtquick-layouts \
    qml6-module-qtquick-dialogs \
    qml6-module-qtquick-templates \
    qml6-module-qtquick-window \
    qml6-module-qtqml-workerscript \
    qml6-module-qtqml-models \
    libpng-dev \
    zlib1g-dev \
    libjpeg-dev \
    libtiff-dev \
    libwebp-dev \
    libheif-dev \
    liblcms2-dev \
    libmypaint-dev \
    libjson-c-dev \
    nodejs \
    python3 \
    python3-venv \
    python3-pip \
    python3-pil \
    python3-yaml \
    python3-numpy \
    python3-scipy \
    python3-skimage \
    python3-opencv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN python3 -m venv --system-site-packages /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

COPY cloud/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    "numpy>=1.26,<2" \
    pytest httpx \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    torch torchvision lpips DISTS-pytorch

COPY . /app
RUN cmake -S /app -B /app/out/linux-headless -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DDRAWBORAD_HEADLESS_WORKFLOW=ON \
    -DDRAWBORAD_QT_CANVAS_TESTS=OFF \
    -DDRAWBORAD_DESKTOP=OFF \
    -DDRAWBORAD_QUALIFY=OFF \
    && cmake --build /app/out/linux-headless --parallel

RUN groupadd -r studio && useradd -r -g studio -d /app studio \
    && mkdir -p /data && chown -R studio:studio /data /app

USER studio
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=4s --start-period=20s \
    CMD python3 -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8765/healthz',timeout=3)" || exit 1
CMD ["python3", "-m", "cloud.cli", "serve", "--host", "0.0.0.0", "--port", "8765"]
