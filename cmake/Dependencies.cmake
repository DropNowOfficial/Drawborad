# No FetchContent, package downloads, pip or network access during configure/build.
if(DRAWBORAD_QUALIFY)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tools/dependency_gate.py"
    --mode Verify --cache "${CMAKE_SOURCE_DIR}/.deps" --profile windows-x64 RESULT_VARIABLE gate)
  if(NOT gate EQUAL 0)
    message(FATAL_ERROR "BLOCKED: Windows dependency qualification incomplete; see reports/foundation")
  endif()
endif()
if(DRAWBORAD_DESKTOP)
  if(NOT WIN32)
    message(FATAL_ERROR "Desktop target is Windows 11 x64")
  endif()
  if(NOT MSVC OR MSVC_VERSION LESS 1930 OR NOT MSVC_VERSION LESS 1950 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "Desktop target requires MSVC 2022 and x64; do not mix compiler/architecture SDKs")
  endif()
  if(NOT DRAWBORAD_QUALIFY AND NOT DRAWBORAD_WINDOWS_VALIDATION)
    message(FATAL_ERROR "Desktop requires either DRAWBORAD_QUALIFY or DRAWBORAD_WINDOWS_VALIDATION")
  endif()
  find_package(Qt6 6.12 REQUIRED COMPONENTS Core Gui Qml Quick QuickControls2)
  if(NOT Qt6_VERSION VERSION_LESS 6.13)
    message(FATAL_ERROR "RC1 requires Qt 6.12.x consistently for build and deployment")
  endif()
endif()
