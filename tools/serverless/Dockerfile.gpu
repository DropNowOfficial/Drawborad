FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
ARG SAM3_REF
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv git ca-certificates libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/python
ENV PATH=/opt/python/bin:$PATH PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir torch==2.10.0 torchvision --index-url https://download.pytorch.org/whl/cu128
RUN test ${#SAM3_REF} -eq 40 && git clone https://github.com/facebookresearch/sam3.git /opt/sam3 && cd /opt/sam3 && git checkout "$SAM3_REF" && pip install --no-cache-dir .
WORKDIR /app
COPY cloud /app/cloud
COPY tools/models /app/tools/models
COPY tools/serverless/requirements.txt /app/tools/serverless/requirements.txt
RUN pip install --no-cache-dir -r tools/serverless/requirements.txt && useradd -u 10001 -m worker
USER worker
# Licensed weights must be mounted/provisioned privately, never COPY them here.
CMD ["python", "-m", "cloud.batch.worker", "--runpod"]
